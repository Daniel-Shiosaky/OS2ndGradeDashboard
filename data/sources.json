{
  "school_name": "2nd Grade",
  "timezone": "America/New_York",
  "sources": [
    {
      "name": "Second Grade Weekly Newsletter",
      "type": "newsletter_board",
      "urlEnv": "SCHOOL_PORTAL_BULLETIN_URL",
      "titlePattern": "Second Grade Newsletter",
      "enabled": true,
      "localOnly": true,
      "priority": 1,
      "lane": "newsletter",
      "role": "2nd grade newsletter"
    },
    {
      "name": "ClassDojo Events",
      "type": "classdojo",
      "url": "https://home.classdojo.com/#/events",
      "enabled": true,
      "localOnly": true,
      "priority": 3,
      "lane": "classdojo",
      "role": "ClassDojo"
    },
    {
      "name": "ClassDojo Class Story",
      "type": "classdojo",
      "url": "https://home.classdojo.com/#/story",
      "enabled": true,
      "localOnly": true,
      "priority": 4,
      "lane": "classdojo",
      "role": "ClassDojo"
    },
    {
      "name": "School Calendar (MyOS)",
      "type": "ical_feed",
      "urlEnv": "MYOS_CALENDAR_FEED_URL",
      "citeUrlEnv": "MYOS_CALENDAR_PAGE_URL",
      "enabled": true,
      "localOnly": false,
      "priority": 2,
      "lane": "calendar",
      "role": "School calendar",
      "wholeSchool": true
    },
    {
      "name": "Teacher Emails",
      "type": "gmail",
      "enabled": true,
      "priority": 2,
      "filterFromEnv": "GMAIL_FILTER_TEACHER",
      "lookbackDays": 14,
      "lane": "email",
      "role": "2nd grade teachers",
      "section": "Teachers",
      "localOnly": false
    },
    {
      "name": "School Portal Announcements",
      "urlEnv": "SCHOOL_PORTAL_ANNOUNCEMENTS_URL",
      "type": "school_portal",
      "enabled": false,
      "localOnly": true,
      "priority": 1,
      "lane": "email",
      "role": "School office",
      "wholeSchool": true,
      "section": "School portal"
    },
    {
      "name": "School Office Communications",
      "type": "gmail",
      "enabled": true,
      "priority": 1,
      "filterFromEnv": "GMAIL_FILTER_COMMUNICATIONS",
      "lookbackDays": 14,
      "lane": "email",
      "role": "School office",
      "wholeSchool": true,
      "section": "General announcements",
      "localOnly": false,
      "broadcastChannel": true
    },
    {
      "name": "School Mass Emails",
      "type": "gmail",
      "enabled": true,
      "priority": 1,
      "filterFromEnv": "GMAIL_FILTER_MASS_EMAILS",
      "lookbackDays": 14,
      "lane": "email",
      "role": "School office",
      "wholeSchool": true,
      "section": "General announcements",
      "localOnly": false,
      "broadcastChannel": true
    },
    {
      "name": "ClassDojo Digest Emails",
      "type": "gmail",
      "enabled": false,
      "priority": 5,
      "filterFromEnv": "GMAIL_FILTER_CLASSDOJO",
      "lookbackDays": 14,
      "lane": "classdojo",
      "role": "ClassDojo"
    }
  ],
  "sectionRules": [
    {
      "titlePattern": "Inside the Spark",
      "section": "General announcements"
    },
    {
      "lane": "calendar",
      "titlePattern": "no school|early release|early dismissal|half day|break|holiday|vacation|teacher work|dismissal",
      "section": "Schedule changes"
    },
    {
      "lane": "calendar",
      "titlePattern": "concert|spectacular|recital|musical|open mic|christmas show|celebrate the season|cider",
      "section": "Concerts & performances"
    },
    {
      "lane": "calendar",
      "titlePattern": ".*",
      "section": "School events"
    }
  ]
}
