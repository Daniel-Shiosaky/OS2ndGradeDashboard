# Copy this file to .env for local development.
# .env is gitignored — never commit real credentials.
# In GitHub Actions, these same names are provided as repository secrets
# (Settings > Secrets and variables > Actions) instead of a committed file.

# AI provider used for extracting structured events from source content.
# Supported: "anthropic" | "openai" | "gemini"
AI_PROVIDER=anthropic

# API key for the configured AI provider. Never hard-code this in source.
# For "gemini", generate a key at https://aistudio.google.com/apikey.
AI_API_KEY=

# Model identifier for the configured provider.
AI_MODEL=claude-sonnet-5

# Optional: override request timeout (ms) for AI calls.
AI_TIMEOUT_MS=60000

# --- Gmail source (type: "gmail" in data/sources.json) ---
# Reads mail via IMAP with an app password — never your real account
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: override if not using Gmail's standard IMAP host.
GMAIL_IMAP_HOST=imap.gmail.com

# --- School portal login (types "school_portal" and "newsletter_board") ---
# For Blackbaud MySchoolApp portals. The login is three hops: the portal takes
# the username, hands off to app.blackbaud.com, and renders the password step as
# an Azure AD B2C form inside an iframe (see loginToPortal in fetchSources.ts).
# SCHOOL_PORTAL_LOGIN_URL is the portal login page, e.g.
#   https://<school>.myschoolapp.com/app/student?svcid=edu#login
SCHOOL_PORTAL_LOGIN_URL=
SCHOOL_PORTAL_USERNAME=
SCHOOL_PORTAL_PASSWORD=

# Bulletin board that links the weekly newsletter, for a "newsletter_board"
# source. A new Google Doc is posted each week, so the doc URL can't be
# hardcoded — the board is scraped to discover the newest one, then the doc
# itself is read over plain HTTP (public link-share, no credentials).
SCHOOL_PORTAL_BULLETIN_URL=

# Portal-backed sources are marked "localOnly" in data/sources.json: a first
# login from an unrecognised device can demand a 6-digit code emailed to the
# account, which an unattended CI run cannot answer. Scheduled runs skip them.
# These three values therefore do NOT need to be GitHub Actions secrets.

# --- ClassDojo parent account (type: "classdojo") ---
# Reads the parent app's own pages (#/events, #/story). Logs in at
# home.classdojo.com/#/login directly rather than clicking through the marketing
# site, whose "Parent" buttons are all sign-up and whose field ids are generated
# per render. An upsell modal after login is dismissed automatically.
# Marked localOnly in data/sources.json: interactive login, so scheduled runs
# skip it and these values do NOT need to be GitHub Actions secrets.
CLASSDOJO_EMAIL=
CLASSDOJO_PASSWORD=

# --- Email lane privacy controls ---
# Only mail BROADCAST to the whole school or class is published; direct messages
# and billing are withheld. See src/shared/parseSchoolEmail.ts for the gates.
#
# Sending domains belonging to mass-mail systems (comma separated). Needed
# because some school mailers set no List-* headers and address each copy
# individually, so the domain is the only broadcast signal.
MAIL_BULK_DOMAINS=

# Bare first names to strip from all published text, and to treat as a signal
# that a message is about one child (comma separated). No pattern can safely
# infer a first name, so they must be listed.
REDACT_NAMES=

# --- Keeping identifying values out of data/sources.json ---
# Any source entry can use "urlEnv"/"filterFromEnv" instead of "url"/
# "filterFrom" — the value is the *name* of an env var to read the real URL
# or sender address from at runtime. This keeps a real school domain,
# teacher's email, etc. out of a committed (possibly public) sources.json.
# Example names used if you follow the pattern from the README:
SCHOOL_PORTAL_ANNOUNCEMENTS_URL=
GMAIL_FILTER_COMMUNICATIONS=
GMAIL_FILTER_MASS_EMAILS=
GMAIL_FILTER_TEACHER=
GMAIL_FILTER_CLASSDOJO=
