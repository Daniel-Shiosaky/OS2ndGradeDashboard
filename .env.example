# Copy this file to .env for local development.
# .env is gitignored — never commit real credentials.
# In GitHub Actions, these same names are provided as repository secrets
# (Settings > Secrets and variables > Actions) instead of a committed file.

# AI provider used for extracting structured events from source content.
# Supported: "anthropic" | "openai" | "gemini"
AI_PROVIDER=anthropic

# API key for the configured AI provider. Never hard-code this in source.
# For "gemini", generate a key at https://aistudio.google.com/apikey.
AI_API_KEY=

# Model identifier for the configured provider.
AI_MODEL=claude-sonnet-5

# Optional: override request timeout (ms) for AI calls.
AI_TIMEOUT_MS=60000

# --- Gmail source (type: "gmail" in data/sources.json) ---
# Reads mail via IMAP with an app password — never your real account
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: override if not using Gmail's standard IMAP host.
GMAIL_IMAP_HOST=imap.gmail.com

# --- School portal source (type: "school_portal" in data/sources.json) ---
# For Blackbaud/MySchoolApp-style portals (#Username / #Password / #loginBtn
# login form). SCHOOL_PORTAL_LOGIN_URL is the portal's login page; each
# school_portal entry's "url" is the specific page to read after logging in.
SCHOOL_PORTAL_LOGIN_URL=
SCHOOL_PORTAL_USERNAME=
SCHOOL_PORTAL_PASSWORD=

# Note: ClassDojo is not supported. Its login page blocks headless browsers
# (bot detection), and this project won't attempt to evade that. If ClassDojo
# can email you class updates, enable that and point a "gmail" source at it
# instead.

# --- Keeping identifying values out of data/sources.json ---
# Any source entry can use "urlEnv"/"filterFromEnv" instead of "url"/
# "filterFrom" — the value is the *name* of an env var to read the real URL
# or sender address from at runtime. This keeps a real school domain,
# teacher's email, etc. out of a committed (possibly public) sources.json.
# Example names used if you follow the pattern from the README:
SCHOOL_PORTAL_ANNOUNCEMENTS_URL=
GMAIL_FILTER_COMMUNICATIONS=
GMAIL_FILTER_MASS_EMAILS=
GMAIL_FILTER_TEACHER=
GMAIL_FILTER_CLASSDOJO=
