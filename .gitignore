# Secrets — never commit. GitHub Actions uses repo secrets instead.
.env
.env.*
!.env.example

# Local agent context — not source-controlled
AGENTS.md

# Dependencies
node_modules/

# Build output
public/app.js
public/app.js.map
dist/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json

# Generated pipeline artifacts — never source-controlled.
# data/events.json carries the bodies of real school emails (scheduling links,
# addresses, quoted threads). It is published to the Pages site, which is a
# week's snapshot, but committing it would put that content in permanent public
# git history. CI recovers the previous state from the live site instead; see
# loadExistingEvents in generateDashboard.ts.
output/
data/events.json
data/pending-review.json

# NOTE: no /docs/* rule here. git uses core.ignorecase=true on macOS, so it also
# matched the tracked Docs/ folder holding the product spec.
