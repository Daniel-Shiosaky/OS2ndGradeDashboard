{
  "name": "school-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static parent dashboard that organizes school information collected via a scheduled AI pipeline.",
  "scripts": {
    "build:frontend": "esbuild src/dashboard/app.ts --bundle --outfile=public/app.js --target=es2020",
    "dev": "npm run build:frontend && tsx src/scripts/devServer.ts",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install --with-deps chromium",
    "fetch-sources": "node --env-file-if-exists=.env --import tsx src/scripts/fetchSources.ts",
    "process-ai": "node --env-file-if-exists=.env --import tsx src/scripts/processWithAi.ts",
    "validate-data": "node --env-file-if-exists=.env --import tsx src/scripts/validateData.ts",
    "generate-dashboard": "node --env-file-if-exists=.env --import tsx src/scripts/generateDashboard.ts",
    "pipeline": "node --env-file-if-exists=.env --import tsx src/scripts/updatePipeline.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "playwright": "^1.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.5.0",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
